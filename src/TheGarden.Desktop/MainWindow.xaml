<Window x:Class="TheGarden.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TheGarden.Desktop"
 Title="Map" Width="1600" Height="960" MinWidth="1200" MinHeight="760" WindowStartupLocation="CenterScreen" WindowState="Maximized" Closing="OnClosing" PreviewKeyDown="OnKeyDown"
 Background="{DynamicResource Paper}" Foreground="{DynamicResource Ink}" FontFamily="{StaticResource Body}" FontSize="13" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
 <Grid x:Name="Page" SizeChanged="Page_SizeChanged">

  <!-- the map is the page -->
  <local:MapView x:Name="Map" Margin="28,84,28,28"/>
  <local:GlobeView x:Name="Globe" Margin="28,84,28,28"/>

  <!-- everything on top of the map; scaled as one for the text size setting -->
  <Grid x:Name="Overlay"><Grid.LayoutTransform><ScaleTransform x:Name="OverlayScale" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>

  <!-- top row: world card | mode (centred in what is left) | view; columns never overlap at any text size -->
  <Grid x:Name="TopRow" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <!-- world card (top left) -->
  <Border Style="{StaticResource Sheet}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="22,18,0,0" Padding="8,8,16,8">
   <StackPanel Orientation="Horizontal">
    <Button x:Name="MenuButton" Content="☰" FontSize="15" Padding="11,6" Click="Menu_Click" ToolTip="지도 · 파일"/>
    <StackPanel VerticalAlignment="Center" Margin="8,0,14,0">
     <TextBlock x:Name="WorldTitle" Text="지도" Style="{StaticResource Title}"/>
     <TextBlock x:Name="SaveState" Text="" Style="{StaticResource Caption}" Margin="0,1,0,0"/>
    </StackPanel>
    <Button x:Name="SaveButton" Content="저장" Style="{StaticResource Quiet}" Click="Save_Click" ToolTip="Ctrl+S" VerticalAlignment="Center"/>
   </StackPanel>
  </Border>
  <Popup x:Name="WorldMenu" PlacementTarget="{Binding ElementName=MenuButton}" Placement="Bottom" VerticalOffset="10" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
   <Border x:Name="WorldMenuSheet" Style="{StaticResource Sheet}" Padding="6" Margin="0,0,14,14" Width="250">
    <StackPanel>
     <Button x:Name="NewWorldButton" Style="{StaticResource MenuItemButton}" Content="새 지도 (바다에서 시작)" Click="NewWorld_Click"/>
     <Button x:Name="ExampleButton" Style="{StaticResource MenuItemButton}" Content="예제 지형" Click="Example_Click"/>
     <Button x:Name="OpenButton" Style="{StaticResource MenuItemButton}" Content="열기…   Ctrl+O" Click="Open_Click"/>
     <Button Style="{StaticResource MenuItemButton}" Content="다른 이름으로 저장…   Ctrl+Shift+S" Click="SaveAs_Click"/>
     <Border Height="1" Background="{DynamicResource Rule}" Margin="8,5"/>
     <Button x:Name="ExportButton" Style="{StaticResource MenuItemButton}" Content="지금 보이는 지도를 그림으로 저장…" Click="Export_Click"/>
     <Button x:Name="ClimateResultButton" Style="{StaticResource MenuItemButton}" Content="기후 요약…" Click="ClimateResult_Click" IsEnabled="False"/>
     <Border Height="1" Background="{DynamicResource Rule}" Margin="8,5"/>
     <TextBlock x:Name="LandText" Text="" Style="{StaticResource Caption}" Margin="12,4,12,0"/>
     <TextBlock x:Name="ResolutionText" Text="" Style="{StaticResource Caption}" Margin="12,2,12,6" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </Popup>

  <!-- mode (top centre), and below it a short-lived notice (saved, errors); never over the map's readout -->
  <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,22,12,0">
   <Border Style="{StaticResource Pill}" HorizontalAlignment="Center">
    <StackPanel Orientation="Horizontal">
     <RadioButton x:Name="ModeTerrain" Style="{StaticResource Segment}" GroupName="Mode" Content="지형 만들기" IsChecked="True" Checked="Mode_Checked" Padding="20,8"/>
     <RadioButton x:Name="ModeClimate" Style="{StaticResource Segment}" GroupName="Mode" Content="기후 보기" Checked="Mode_Checked" Padding="20,8"/>
    </StackPanel>
   </Border>
   <Border x:Name="ToastChip" Style="{StaticResource Pill}" HorizontalAlignment="Center" Margin="0,6,0,0" Padding="14,4" Visibility="Collapsed" IsHitTestVisible="False">
    <TextBlock x:Name="ToastText" Text="" FontSize="12" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center"/>
   </Border>
  </StackPanel>

  <!-- view (top right) -->
  <Border Grid.Column="2" Style="{StaticResource Pill}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,22,22,0">
   <StackPanel Orientation="Horizontal">
    <RadioButton x:Name="ViewMapButton" Style="{StaticResource Segment}" GroupName="View" Content="평면" Checked="View_Checked"/>
    <RadioButton x:Name="ViewGlobeButton" Style="{StaticResource Segment}" GroupName="View" Content="지구본" Checked="View_Checked"/>
    <RadioButton x:Name="ViewSplitButton" Style="{StaticResource Segment}" GroupName="View" Content="함께" IsChecked="True" Checked="View_Checked" ToolTip="평면 지도와 지구본을 나란히 (어느 쪽에서 그려도 양쪽에 같이 반영)"/>
    <Border Width="1" Margin="6,6" Background="{DynamicResource Rule}"/>
    <ToggleButton x:Name="GridToggle" Style="{StaticResource Switch}" Content="격자" IsChecked="True" Checked="DisplayChanged" Unchecked="DisplayChanged" ToolTip="위도·경도선"/>
    <ToggleButton x:Name="ShadeToggle" Style="{StaticResource Switch}" Content="음영" IsChecked="True" Checked="DisplayChanged" Unchecked="DisplayChanged" ToolTip="지형 음영"/>
    <Button Content="⟲" Click="ResetView_Click" ToolTip="시점 초기화" FontSize="14" Padding="10,5"/>
    <Border Width="1" Margin="6,6" Background="{DynamicResource Rule}"/>
    <Button x:Name="ThemeButton" Content="☾" Click="Theme_Click" ToolTip="어두운 화면으로" FontSize="15" Padding="10,3"/>
    <Button x:Name="TextSizeButton" Content="가" Click="TextSize_Click" ToolTip="글자 크기 (Ctrl + = / Ctrl + − / Ctrl + 0)" FontSize="15" Padding="10,3"/>
    <Border Width="1" Margin="6,6" Background="{DynamicResource Rule}"/>
    <Button x:Name="UndoButton" Content="↶" Click="Undo_Click" ToolTip="실행 취소 (Ctrl+Z)" FontSize="15" Padding="10,4"/>
    <Button x:Name="RedoButton" Content="↷" Click="Redo_Click" ToolTip="다시 실행 (Ctrl+Y)" FontSize="15" Padding="10,4"/>
   </StackPanel>
  </Border>

  </Grid>
  <Popup x:Name="TextSizePopup" PlacementTarget="{Binding ElementName=TextSizeButton}" Placement="Bottom" VerticalOffset="10" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
   <Border x:Name="TextSizeSheet" Style="{StaticResource Pill}" Margin="0,0,14,14">
    <StackPanel Orientation="Horizontal">
     <Button x:Name="TextSmallerButton" Content="가−" Click="TextSmaller_Click" ToolTip="글자 작게 (Ctrl + −)" FontSize="13" Padding="12,5"/>
     <Button Click="TextReset_Click" ToolTip="100%로 (Ctrl + 0)" Padding="8,5"><TextBlock x:Name="TextSizeLabel" Text="100%" FontSize="12" Foreground="{DynamicResource Muted}"/></Button>
     <Button x:Name="TextLargerButton" Content="가+" Click="TextLarger_Click" ToolTip="글자 크게 (Ctrl + =)" FontSize="16" Padding="12,3"/>
    </StackPanel>
   </Border>
  </Popup>

  <!-- ===== terrain mode ===== -->
  <Grid x:Name="TerrainLayer">
   <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,0,0" Padding="5,7">
    <StackPanel>
     <RadioButton x:Name="NavigateTool" Style="{StaticResource Brush}" GroupName="Tool" Tag="Navigate" IsChecked="True" Checked="Tool_Checked" ToolTip="둘러보기 · 지점 고르기 (1)"><TextBlock Text="◎" FontSize="18"/></RadioButton>
     <Border Height="1" Margin="8,4" Background="{DynamicResource Rule}"/>
     <RadioButton x:Name="FlattenTool" Style="{StaticResource Brush}" GroupName="Tool" Tag="Flatten" Checked="Tool_Checked" ToolTip="목표 고도로 맞추기 (2)"><TextBlock Text="═" FontSize="16"/></RadioButton>
     <RadioButton x:Name="SmoothTool" Style="{StaticResource Brush}" GroupName="Tool" Tag="Smooth" Checked="Tool_Checked" ToolTip="부드럽게 (3)"><TextBlock Text="∿" FontSize="18"/></RadioButton>
     <RadioButton x:Name="RidgeTool" Style="{StaticResource Brush}" GroupName="Tool" Tag="Ridge" Checked="Tool_Checked" ToolTip="산맥 그리기 (4)"><TextBlock Text="⋀" FontSize="17"/></RadioButton>
     <RadioButton x:Name="PickTool" Style="{StaticResource Brush}" GroupName="Tool" Tag="Pick" Checked="Tool_Checked" ToolTip="고도 찍기 (5)"><TextBlock Text="⌖" FontSize="18"/></RadioButton>
    </StackPanel>
   </Border>
   <!-- brush settings: one bar in the band above the map (placed by UpdateMapFrame), never over the map -->
   <Border x:Name="BrushCard" Style="{StaticResource Sheet}" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="16,9" Visibility="Collapsed" SizeChanged="BrushCard_SizeChanged">
    <StackPanel Orientation="Horizontal">
     <StackPanel Width="170" VerticalAlignment="Center">
      <TextBlock x:Name="BrushTitle" Text="붓" Style="{StaticResource Title}" FontSize="16"/>
      <TextBlock x:Name="BrushHint" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
     </StackPanel>
     <Border Width="1" Background="{DynamicResource Rule}" Margin="14,2"/>
     <!-- the height comes first: it is what the target-height and ridge brushes are about -->
     <StackPanel x:Name="TargetPanel" Width="160" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed">
      <TextBlock x:Name="TargetLabel" Text="목표 고도 (m)" Style="{StaticResource Eyebrow}" Margin="0,0,0,4"/>
      <TextBox x:Name="TargetBox" Text="1500" TextChanged="TargetChanged" ToolTip="−12,000 ~ 12,000 m · 바다 0 m 아래, 육지 위" AutomationProperties.Name="목표 고도 m"/>
      <TextBlock x:Name="TargetError" Foreground="{DynamicResource Alert}" FontSize="10.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
     </StackPanel>
     <StackPanel x:Name="RadiusPanel" Orientation="Horizontal">
      <StackPanel Width="160" VerticalAlignment="Center" Margin="0,0,16,0">
       <DockPanel><TextBlock Text="크기" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="RadiusLabel" Text="650 km" HorizontalAlignment="Right" FontSize="11.5"/></DockPanel>
       <Slider x:Name="RadiusSlider" Minimum="100" Maximum="2000" Value="650" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="BrushChanged" Margin="0,4,0,0" AutomationProperties.Name="붓 반경 km"/>
      </StackPanel>
      <StackPanel x:Name="SoftnessPanel" Width="160" VerticalAlignment="Center" Margin="0,0,16,0">
       <DockPanel><TextBlock Text="가장자리 부드러움" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="SoftnessLabel" Text="100%" HorizontalAlignment="Right" FontSize="11.5"/></DockPanel>
       <Slider x:Name="SoftnessSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="BrushChanged" Margin="0,4,0,0" AutomationProperties.Name="가장자리 부드러움 %" ToolTip="0%: 가장자리까지 같은 세기(또렷한 경계) · 100%: 가운데서 가장자리로 서서히 약해짐"/>
      </StackPanel>
     </StackPanel>
     <StackPanel x:Name="RoughnessPanel" Width="160" VerticalAlignment="Center" Margin="0,0,16,0">
      <DockPanel><TextBlock Text="거칠기" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="RoughnessLabel" Text="30%" HorizontalAlignment="Right" FontSize="11.5"/></DockPanel>
      <Slider x:Name="RoughnessSlider" Minimum="0" Maximum="100" Value="30" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="BrushChanged" Margin="0,4,0,0" AutomationProperties.Name="거칠기 %" ToolTip="0%: 매끈하게 바뀜 · 올릴수록 자리마다 들쭉날쭉하게 바뀌어 봉우리와 골이 생김 (5 km 칸까지)"/>
     </StackPanel>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource Sheet}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,22" Padding="14,10">
    <StackPanel Width="260">
     <TextBlock Text="고도" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
     <Border Height="10" CornerRadius="5"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#122C49" Offset="0"/><GradientStop Color="#33728A" Offset=".37"/><GradientStop Color="#779D9E" Offset=".48"/><GradientStop Color="#B6C6A0" Offset=".5"/><GradientStop Color="#7D977C" Offset=".66"/><GradientStop Color="#AF9771" Offset=".8"/><GradientStop Color="#E0C5A0" Offset="1"/></LinearGradientBrush></Border.Background></Border>
     <Grid Margin="0,4,0,0"><TextBlock Text="−6,000" Style="{StaticResource Caption}" FontSize="10"/><TextBlock Text="해수면" HorizontalAlignment="Center" Style="{StaticResource Caption}" FontSize="10"/><TextBlock Text="6,000 m" HorizontalAlignment="Right" Style="{StaticResource Caption}" FontSize="10"/></Grid>
    </StackPanel>
   </Border>
  </Grid>

  <!-- ===== climate mode ===== -->
  <Grid x:Name="ClimateLayer" Visibility="Collapsed">
   <!-- run / progress / stale card, centred over the map -->
   <Border x:Name="RunCard" Style="{StaticResource Sheet}" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22">
    <StackPanel>
     <TextBlock x:Name="RunTitle" Text="이 지도의 기후" Style="{StaticResource Headline}"/>
     <TextBlock x:Name="RunText" Text="" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,14" LineHeight="20"/>
     <StackPanel x:Name="RunProgress" Visibility="Collapsed" Margin="0,4,0,0">
      <ProgressBar x:Name="ClimateProgressBar" Maximum="100"/>
      <TextBlock x:Name="ClimateStateText" Text="" FontWeight="SemiBold" Margin="0,8,0,0" AutomationProperties.Name="기후 계산 상태"/>
      <TextBlock x:Name="ClimateDetailText" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,3,0,0"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
      <Button x:Name="ClimateRunButton" Content="기후 계산 시작" Style="{StaticResource Action}" Click="ClimateRun_Click"/>
      <Button x:Name="ClimateCancelButton" Content="취소" Style="{StaticResource Quiet}" Click="ClimateCancel_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
      <Button x:Name="RunCloseButton" Content="닫기" Click="RunClose_Click" Visibility="Collapsed" Margin="8,0,0,0"/>
     </StackPanel>
    </StackPanel>
   </Border>

   <!-- layer dock (bottom) -->
   <Border x:Name="ClimateResultPanel" Style="{StaticResource Sheet}" VerticalAlignment="Bottom" Margin="22,0,22,22" Padding="14,10,14,8" Visibility="Collapsed">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel LastChildFill="False">
      <Border DockPanel.Dock="Left" Background="{DynamicResource CardSoft}" CornerRadius="17" Padding="3"><StackPanel x:Name="StateList" Orientation="Horizontal"/></Border>
      <Border x:Name="SeasonBar" DockPanel.Dock="Left" Background="{DynamicResource CardSoft}" CornerRadius="17" Padding="3" Margin="10,0,0,0"><StackPanel x:Name="SeasonList" Orientation="Horizontal"/></Border>
      <ToggleButton x:Name="CloudToggle" DockPanel.Dock="Left" Style="{StaticResource Switch}" Content="☁ 구름" Margin="8,0,0,0" Visibility="Collapsed" Checked="Cloud_Changed" Unchecked="Cloud_Changed" ToolTip="이 계절의 구름을 덮어 봅니다 (비가 많은 곳일수록 구름이 많습니다)"/>
      <Button x:Name="RerunButton" DockPanel.Dock="Right" Content="다시 계산…" Style="{StaticResource Quiet}" Click="Rerun_Click"/>
      <TextBlock x:Name="DockInfo" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,12,0"/>
     </DockPanel>
     <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
      <StackPanel x:Name="LayerList" Orientation="Horizontal"/>
     </ScrollViewer>
    </Grid>
   </Border>

   <!-- legend for the shown layer (above the dock, right) -->
   <Border x:Name="LegendCard" Style="{StaticResource Sheet}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="22,0,0,214" Padding="14,10" MaxWidth="560" Visibility="Collapsed">
    <StackPanel>
     <TextBlock x:Name="LegendTitle" Text="" Style="{StaticResource Eyebrow}" Margin="0,0,0,6" Cursor="Hand" MouseLeftButtonUp="LegendTitle_Click" ToolTip="눌러서 범례 접기·펴기"/>
     <Image x:Name="ClimateLegend" Height="56" Stretch="Uniform" HorizontalAlignment="Left" Visibility="Collapsed" AutomationProperties.Name="기후 층 범례"/>
     <ScrollViewer x:Name="ClimateLegendScroll" MaxHeight="96" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed"><WrapPanel x:Name="ClimateLegendItems" MaxWidth="530"/></ScrollViewer>
    </StackPanel>
   </Border>

   <!-- inspector: the clicked place -->
   <Border x:Name="Inspector" Style="{StaticResource Sheet}" Width="340" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,84,22,214" Padding="18,16" Visibility="Collapsed">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <DockPanel>
      <Button DockPanel.Dock="Right" Content="✕" Click="InspectorClose_Click" Padding="8,3" VerticalAlignment="Top" ToolTip="닫기"/>
      <Border x:Name="KoppenBadge" Width="46" Height="46" CornerRadius="10" Background="{DynamicResource Rule}" Margin="0,0,12,0" VerticalAlignment="Top">
       <TextBlock x:Name="KoppenCode" Text="" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel>
       <TextBlock x:Name="InspectorTitle" Text="" Style="{StaticResource Title}" FontSize="17" TextWrapping="Wrap"/>
       <TextBlock x:Name="InspectorSubtitle" Text="" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
      </StackPanel>
     </DockPanel>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
      <StackPanel>
       <local:Climograph x:Name="ClimateGraph" Margin="0,0,0,10"/>
       <TextBlock x:Name="ClimatePointText" Text="" FontSize="12" TextWrapping="Wrap" LineHeight="19"/>
       <TextBlock Text="기후 이유" Style="{StaticResource Eyebrow}" Margin="0,14,0,4"/>
       <TextBlock x:Name="InspectorWhy" Text="" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
       <TextBlock x:Name="InspectorFoot" Text="" Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Border>
  </Grid>

  <!-- hover readout and messages -->
  <Border x:Name="StatusChip" Style="{StaticResource Pill}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Padding="16,7" IsHitTestVisible="False">
   <TextBlock x:Name="StatusText" Text="" FontSize="12"/>
  </Border>
  <TextBlock x:Name="CoordinateText" Visibility="Collapsed"/>
  <TextBlock x:Name="ElevationText" Visibility="Collapsed"/>
  </Grid>
 </Grid>
</Window>
